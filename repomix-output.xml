}

.log-info b {
  font-size: 1rem;
}

/* Botón consultar operaciones */
.btn-consultar-operaciones {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: 20px;
  padding: 14px 24px;
  border: none;
  border-radius: 14px;
  background: linear-gradient(
    135deg,
    rgba(99, 102, 241, 0.95) 0%,
