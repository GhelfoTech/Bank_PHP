/* ESTILOS DE AUTENTICACIÓN (Registro/Login)    */
/* ============================================ */
.auth-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  min-height: 100vh;
}

